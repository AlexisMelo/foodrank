{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "PowerShell(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-commit.js\"",
            "statusMessage": "Checking for git commits"
          }
        ]
      }
    ]
  }
}
