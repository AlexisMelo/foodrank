# Code conventions checked at build time (see claude.md > Code Conventions).

[*.cs]

# Public types and members must have an XML documentation comment (/// <summary>).
# Requires <GenerateDocumentationFile> in api.csproj. Private members (constants, fields)
# are not covered by any built-in analyzer: that part of the rule is only in claude.md.
dotnet_diagnostic.CS1591.severity = warning

# XML documentation comments must be well-formed and reference existing symbols.
dotnet_diagnostic.CS1570.severity = warning
dotnet_diagnostic.CS1572.severity = warning
dotnet_diagnostic.CS1573.severity = warning
dotnet_diagnostic.CS1574.severity = warning
